<resources>
    <style name="Theme.DrishtiSaathi" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_background</item>
    </style>

    <!-- Android 12 SplashScreen API (androidx core-splashscreen on older phones): the eye mark on brand blue, then the app. -->
    <style name="Theme.DrishtiSaathi.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.DrishtiSaathi</item>
    </style>
</resources>
