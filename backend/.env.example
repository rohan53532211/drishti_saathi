# Copy to backend/.env (never commit .env). Only the backend holds the Sarvam key; it is never in the APK.
SARVAM_API_KEY=your-sarvam-api-subscription-key

# Optional: shared token the app sends as X-Bridge-Token (set the same value in the app's staff settings).
BRIDGE_TOKEN=

# Optional overrides (defaults shown). Check docs.sarvam.ai if Sarvam renames a model.
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_CHAT_MODEL=sarvam-105b
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=priya
# SARVAM_TTS_PACE=0.9
# SARVAM_TIMEOUT_S=25
# BRIDGE_DB=bridge.db

# Teleconsult portal. The one admin account is created from these two at start-up (leave empty for no admin).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
# Optional: key that signs the login tokens. If empty, a random one is created and kept in the database.
JWT_SECRET=
# Demo accounts made by `python -m app.seed_demo` (DEMO data only; all get this password).
DEMO_PASSWORD=change-this-demo-password
